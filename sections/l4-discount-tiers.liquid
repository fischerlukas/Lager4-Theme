      "default": 30
    },
    {
      "type": "range",
      "id": "price_size_mobile",
      "min": 14,
      "max": 114,
      "step": 1,
      "unit": "px",
      "label": "Mobile price size",
      "default": 24
    },
    {
      "type": "range",
      "id": "tag_size",
      "min": 12,
      "max": 112,
      "step": 1,
      "unit": "px",
      "label": "Discount tag text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "tag_size_mobile",
      "min": 11,
      "max": 111,
      "step": 1,
      "unit": "px",
      "label": "Mobile discount tag text size",
      "default": 14
    },
    {
